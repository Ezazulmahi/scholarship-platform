# Copy to backend/.env. Never commit the real file.
PORT=5000
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Supabase project URL and service role key (server side only, never expose to the browser)
SUPABASE_URL=
SUPABASE_KEY=
# Where the FastAPI AI service runs
AI_SERVICE_URL=http://localhost:8000
# Deployed frontend, plus any extra comma separated origins allowed by CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=
# SMTP for OTP emails (Gmail needs an app password)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="ScholarPath" <you@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Optional rate limit overrides
AUTH_RATE_LIMIT=50
OTP_ATTEMPT_LIMIT=5
AI_RATE_LIMIT=20
